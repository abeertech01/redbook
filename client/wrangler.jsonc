{
  "name": "redbook-client",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    // Any path with no matching static file (e.g. /post/:id, /messages/:chatId)
    // falls back to index.html instead of 404ing, so React Router can handle
    // it client-side. Do NOT also add a client/public/_redirects catch-all
    // rule alongside this - Cloudflare's build rejects "/* /index.html 200"
    // as an infinite loop when combined with this setting (error 100324).
    "not_found_handling": "single-page-application"
  }
}
